menu "Project Configuration"

    config PROJ_NAME
        string "Project name"
        default "desktop_robot"
        help
            Name of this project.

    config PROJ_VERSION
        string "Project version"
        default "0.1.0"
        help
            Semantic version of the firmware.

    config CHAT_CONTINUOUS
        bool "Continuous conversation mode (auto relisten after reply)"
        default y
        help
            After TTS playback finishes, restart listening automatically
            instead of returning to standby. Silence timeout ends the
            conversation. KEY0 still starts a session from standby.

endmenu
